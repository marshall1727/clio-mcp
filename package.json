{
  "name": "clio-mcp",
  "version": "1.0.0-beta.1",
  "description": "MCP server that lets Claude work in Clio Manage (Clio API v4): documents, time entries, billing data, matters, contacts, tasks, calendar.",
  "license": "Apache-2.0",
  "author": "marshall1727",
  "repository": {
    "type": "git",
    "url": "https://github.com/marshall1727/clio-mcp.git"
  },
  "homepage": "https://github.com/marshall1727/clio-mcp#readme",
  "bugs": "https://github.com/marshall1727/clio-mcp/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "clio",
    "clio-manage",
    "legal",
    "law-firm",
    "claude"
  ],
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && node build.mjs",
    "start": "node dist/index.js",
    "fetch-spec": "node tools/fetch-spec.mjs",
    "catalog": "node tools/gen-catalog.mjs",
    "pack": "node tools/pack.mjs",
    "check-locales": "node tools/check-locales.mjs",
    "test": "npm run typecheck && npm run check-locales"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@napi-rs/canvas": "^1.0.9",
    "fflate": "^0.8.2",
    "pdfjs-dist": "^4.10.38",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.0"
  }
}
